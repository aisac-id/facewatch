{
  "manifest_version": 3,
  "name": "FaceWatch — Face ID Sentinel",
  "version": "1.0.0",
  "description": "On-device face detection & recognition for webcams and CCTV (MJPEG / snapshot URLs). Enroll faces, match live, alert on strangers. 100% local.",
  "action": {
    "default_title": "Open FaceWatch",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}